{% extends "/admin/design.twig" %}

{% block content %}
{% if Notice %}
<div class="alert alert-{{Notice.type}}" role="alert">{{Notice.message}}</div>
{% endif %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-muted mb-0">Manage admin logins. Deleting a user removes their access immediately.</p>
    </div>
    <span class="badge badge-dark">{{Users|length}} total</span>
</div>

<table class="table table-striped table-hover">
    <thead class="thead-light">
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Email</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right">Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for User in Users %}
        <tr>
            <th scope="row">{{User.ID}}</th>
            <td>{{User.Email}}</td>
            <td>
                {% if User.ID == CurrentUserID %}
                    <span class="badge badge-primary">Current session</span>
                {% else %}
                    <span class="badge badge-secondary">Active</span>
                {% endif %}
            </td>
            <td class="text-right">
                {% if User.ID == CurrentUserID %}
                    <button class="btn btn-sm btn-outline-secondary" disabled>Delete</button>
                {% else %}
                    <form method="post" action="/admin/users/delete/{{User.ID}}" class="d-inline" onsubmit="return confirm('Delete {{User.Email|e('js')}}? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4" class="text-center text-muted py-4">No users found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
